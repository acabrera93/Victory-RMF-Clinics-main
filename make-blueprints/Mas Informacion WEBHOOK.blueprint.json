            "mapper": {
                "to": ["{{22.email}}"],
                "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<title>{{if(contains(22.programa; \"World Challenge\"); \"Real Madrid Foundation World Challenge 2027 - Presentación del programa\"; \"Real Madrid Foundation Clinic 2027 - Presentación del programa\")}}</title>\n</head>\n<body style=\"margin:0; padding:0; background:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#1a2e46;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7fb; padding:40px 16px;\">\n  <tr>\n    <td align=\"center\">\n\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(11,31,58,0.08);\">\n\n        <tr>\n          <td style=\"background:#0a1f3c; padding:32px 40px; text-align:center;\">\n            <table cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto 18px auto;\">\n              <tr>\n                <td style=\"padding:0 14px; vertical-align:middle;\">\n                  <img src=\"https://lh3.googleusercontent.com/d/1XfpwTY8c5GDI4ssInLnIKxJ37UOPKKmO\" alt=\"Fundación Revel\" height=\"48\" style=\"display:block; height:48px; width:auto;\">\n                </td>\n                <td style=\"padding:0 14px; vertical-align:middle;\">\n                  <img src=\"https://lh3.googleusercontent.com/d/1USK2ut3e0f1VwBbQ8uNqVSD517KtdZZQ\" alt=\"Real Madrid Foundation\" height=\"60\" style=\"display:block; height:60px; width:auto;\">\n                </td>\n              </tr>\n            </table>\n            <div style=\"color:#5a9de0; font-size:11px; letter-spacing:2px; text-transform:uppercase; margin-bottom:10px;\">FUNDACIÓN REVEL - REAL MADRID FOUNDATION</div>\n            <div style=\"color:#ffffff; font-size:26px; font-weight:bold; letter-spacing:1px; line-height:1.2;\">{{if(contains(22.programa; \"World Challenge\"); \"REAL MADRID FOUNDATION WORLD CHALLENGE 2027\"; \"REAL MADRID FOUNDATION CLINIC 2027\")}}</div>\n            <div style=\"color:rgba(255,255,255,0.7); font-size:14px; margin-top:8px;\">{{if(contains(22.programa; \"World Challenge\"); \"19 al 27 de marzo 2027 - Madrid, España\"; \"Octubre 2027 - Madrid, España\")}}</div>\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:36px 40px 24px;\">\n            <p style=\"font-size:18px; color:#0a1f3c; margin:0 0 18px;\">¡Hola <strong>{{22.nombre}}</strong>!</p>\n\n            <p style=\"font-size:15px; line-height:1.7; color:#4a6080; margin:0 0 16px;\">\n              {{if(contains(22.programa; \"World Challenge\"); \"Gracias por tu interés en el <strong style='color:#1e5ba8;'>Real Madrid Foundation World Challenge 2027</strong>, el torneo internacional juvenil de la Fundación Real Madrid para jugadores de 8 a 14 años.\"; \"Gracias por tu interés en el <strong style='color:#1e5ba8;'>Real Madrid Foundation Clinic 2027</strong>, el programa oficial de la Fundación Real Madrid para jóvenes de 8 a 17 años.\")}}\n            </p>\n\n            <p style=\"font-size:15px; line-height:1.7; color:#4a6080; margin:0 0 16px;\">\n              {{if(contains(22.programa; \"World Challenge\"); \"Te enviamos la presentación completa del programa con todos los detalles: el torneo World Challenge en la Ciudad Deportiva del Real Madrid, la agenda día a día, las actividades en Madrid, el plan para acompañantes (Family Experience) y, por supuesto, los precios y formas de pago.\"; if(22.pdf_link; \"Te enviamos la presentación completa del programa con todos los detalles: entrenamientos oficiales en la Ciudad Deportiva del Real Madrid, la Victory Cup, las actividades en Madrid y, por supuesto, los precios y formas de pago.\"; \"La presentación completa del Clinic 2027 (fechas exactas, agenda, actividades en Madrid, precios y formas de pago) estará disponible muy pronto. Te la enviaremos en cuanto esté lista y, mientras tanto, un asesor te contactará para resolver tus dudas.\"))}}\n            </p>\n\n            <p style=\"font-size:15px; line-height:1.7; color:#4a6080; margin:0 0 28px;\">\n              {{if(22.pdf_link; \"Haz clic en el primer botón para ver la presentación. Cuando estés listo para asegurar el cupo de tu hijo, completa la inscripción en el segundo botón. Y si tienes alguna duda, escríbenos directo por WhatsApp.\"; \"Cuando estés listo para asegurar el cupo de tu hijo, completa la inscripción en el botón de abajo. Y si tienes alguna duda, escríbenos directo por WhatsApp.\")}}\n            </p>\n\n            <table cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto 24px auto;\">\n              <tr style=\"{{if(22.pdf_link; \"\"; \"display:none;\")}}\">\n                <td style=\"background:#0a1f3c; border-radius:6px; padding:14px 32px; text-align:center;\">\n                  <a href=\"{{22.pdf_link}}\" style=\"color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none;\">\n                    Ver presentación del programa\n                  </a>\n                </td>\n              </tr>\n              <tr style=\"{{if(22.pdf_link; \"\"; \"display:none;\")}}\"><td style=\"height:10px;\"></td></tr>\n              <tr>\n                <td style=\"background:#3b7fd4; border-radius:6px; padding:14px 32px; text-align:center;\">\n                  <a href=\"https://victory.com.es/inscripcion.html?programa={{encodeURL(22.programa)}}\" style=\"color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none;\">\n                    Completar inscripción\n                  </a>\n                </td>\n              </tr>\n              <tr><td style=\"height:10px;\"></td></tr>\n              <tr>\n                <td style=\"background:#25D366; border-radius:6px; padding:14px 32px; text-align:center;\">\n                  <a href=\"https://wa.me/34620301690?text={{if(contains(22.programa; \"World Challenge\"); \"Hola%20Fundaci%C3%B3n%20Revel%2C%20tengo%20una%20duda%20sobre%20el%20RMF%20World%20Challenge%202027\"; \"Hola%20Fundaci%C3%B3n%20Revel%2C%20tengo%20una%20duda%20sobre%20el%20RMF%20Clinic%202027\")}}\" style=\"color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none;\">\n                    Tengo una duda - WhatsApp\n                  </a>\n                </td>\n              </tr>\n            </table>\n\n            <p style=\"font-size:13px; line-height:1.6; color:#8da4bf; margin:24px 0 0; text-align:center;\">\n              Un asesor de Fundación Revel te contactará en las próximas 24 horas para resolver cualquier duda.\n            </p>\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:0 40px;\">\n            <div style=\"height:1px; background:#e2e8f0;\"></div>\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding:24px 40px 32px; text-align:center;\">\n            <p style=\"font-size:13px; color:#4a6080; margin:0 0 10px;\">\n              <strong>Alejandro Cabrera</strong><br>\n              Director Experiencias Internacionales - Fundación Revel\n            </p>\n            <p style=\"font-size:13px; color:#8da4bf; margin:0 0 14px;\">\n              <a href=\"https://wa.me/34620301690\" style=\"color:#1e5ba8; text-decoration:none;\">WhatsApp +34 620 301 690</a>\n              &nbsp;-&nbsp;\n              <a href=\"mailto:alejandro.cabrera@fundacionrevel.net\" style=\"color:#1e5ba8; text-decoration:none;\">Escribir correo</a>\n            </p>\n            <p style=\"font-size:11px; color:#a0b1c8; margin:0;\">\n              &copy; {{formatDate(now; \"YYYY\")}} Fundación Revel\n            </p>\n          </td>\n        </tr>\n\n      </table>\n\n      <p style=\"font-size:11px; color:#a0b1c8; margin:18px 0 0; text-align:center;\">\n        Si no solicitaste esta información, puedes ignorar este correo.\n      </p>\n\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>",
